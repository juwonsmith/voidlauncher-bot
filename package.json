{
  "name": "telegram-launchpad-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate:sqlite": "npm run build && node scripts/migrate-sqlite-to-postgres.mjs",
    "vanity:worker": "cargo run --release --manifest-path rust/vanity-worker/Cargo.toml",
    "vanity:pump": "node scripts/run-vanity-worker.mjs pump",
    "vanity:bonk": "node scripts/run-vanity-worker.mjs bonk",
    "vanity:bags": "node scripts/run-vanity-worker.mjs bags",
    "vanity:all": "node scripts/run-all-vanity-workers.mjs",
    "vanity:custom": "node scripts/run-custom-ca-worker.mjs",
    "grinder:deploy": "node scripts/deploy-grinder.mjs"
  },
  "dependencies": {
    "@bagsfm/bags-sdk": "^1.3.7",
    "@pump-fun/pump-sdk": "^1.33.0",
    "@solana/web3.js": "^1.98.0",
    "better-sqlite3": "^11.8.1",
    "bn.js": "^5.2.3",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.7",
    "pg": "^8.22.0",
    "telegraf": "^4.16.3",
    "tweetnacl": "^1.0.3",
    "viem": "^2.55.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
