TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_IDS=6443630609
ALLOW_GROUP_ADMINS=true
DATABASE_PATH=./data/bot.sqlite
DRY_RUN=true

# Required for Pump.fun API/global launches with the official Pump.fun SDK.
# Group launches use the encrypted group wallet instead.
PUMPFUN_SIGNER_PRIVATE_KEY=
PUMPFUN_CASHBACK=false
# Optional Pump.fun creator-fee split. Total bps must equal 10000.
# Example: creator wallet gets 8000 bps, treasury gets 2000 bps.
PUMPFUN_FEE_SHARES=

# Optional per-launch platform fee. Charged only after a successful live launch.
PLATFORM_TREASURY_WALLET=
PLATFORM_FEE_SOL=0.02

# Required for Bonk live launches through PumpPortal Lightning API.
PUMPPORTAL_API_KEY=
# Required for Bags live launches through Bags SDK/API.
BAGS_API_KEY=

# Required for Pump.fun metadata uploads. Bonk uses Bonk metadata workers.
PINATA_JWT=

SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BALANCE_CHECK_TIMEOUT_MS=12000
BALANCE_CHECK_ATTEMPTS=3
DEFAULT_DEV_BUY_SOL=0.01
MAX_DEV_BUY_SOL=0.05
GROUP_DAILY_LAUNCH_LIMIT=10
USER_DAILY_LAUNCH_LIMIT=3
RATE_LIMIT_WINDOW_MS=10000
RATE_LIMIT_MAX_UPDATES=12
DEFAULT_SLIPPAGE_PERCENT=10
DEFAULT_PRIORITY_FEE_SOL=0.00005
# Leave empty to use PumpPortal's default SOL quote mint. Only set this if the wallet is funded with that quote token.
BONK_QUOTE_MINT=

# Optional Pump.fun vanity mint suffix. Set to "pump" only if you accept slow launches.
# For fast launches with suffixes, run npm run vanity:all.

PUMP_MINT_MAX_ATTEMPTS=25000000
PUMP_MINT_SUFFIX=pump
BONK_MINT_SUFFIX=bonk
# Bags SDK currently generates the mint internally; leave empty unless Bags adds custom mint support.
BAGS_MINT_SUFFIX=
PUMP_MINT_POOL_SIZE=3
PUMP_MINT_WORKERS=4

# Trading bot links shown after launch. Use {mint} where the CA should go.
# Trojan official deep-link format is r-{refcode}-{mint}.
TROJAN_REF_CODE=
TROJAN_LINK_TEMPLATE=https://t.me/solana_trojanbot?start=r-{ref}-{mint}
BASED_LINK_TEMPLATE=https://t.me/based_eth_bot?start=r_<referral>_b_{mint}
AXIOM_LINK_TEMPLATE=https://axiom.trade/t/{mint}/@thadev?chain=sol

# Live launch retry behavior. The bot retries confirmed failures, but not unknown pending confirmations.
LAUNCH_MAX_ATTEMPTS=3
LAUNCH_RETRY_DELAY_MS=3000
LAUNCH_CONFIRM_ATTEMPTS=20
LAUNCH_CONFIRM_DELAY_MS=3000
LAUNCH_JOB_POLL_MS=2000
LAUNCH_JOB_MAX_ATTEMPTS=3
REQUIRE_LAUNCH_CONFIRMATION=true

# Image validation before launch.
MAX_IMAGE_BYTES=2000000
MIN_IMAGE_DIMENSION=256
MAX_IMAGE_DIMENSION=2048
REQUIRE_SQUARE_IMAGE=true

# Optional. If omitted, bot creates data/wallet.key automatically. Back this up if using bot-created wallets.
WALLET_ENCRYPTION_KEY=
LOG_DIR=./logs
HEALTHCHECK_PORT=3001
